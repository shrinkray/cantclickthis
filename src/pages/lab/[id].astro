---
import '../../styles/global.css';
import { sections } from '../../lib/sections.mjs';
import { highlightCode } from '../../lib/highlight.mjs';
import BrandFooter from '../../components/BrandFooter.astro';

export function getStaticPaths() {
  return sections.map((section) => ({
    params: { id: section.id },
    props: { section }
  }));
}

const { section } = Astro.props;
const total = String(sections.length).padStart(2, '0');
const index = sections.findIndex((item) => item.id === section.id);
const prev = index > 0 ? sections[index - 1] : null;
const next = index < sections.length - 1 ? sections[index + 1] : null;
const title = `${section.title} — Screen reader lab`;
const description = section.tryIt;
const failMarkup = section.failMarkup.trim();
const fixMarkup = section.fixMarkup.trim();
const source = JSON.stringify({ fail: failMarkup, fix: fixMarkup });
const failHighlighted = highlightCode(failMarkup);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://cantclickthis.dev/lab/${section.id}`} />
    <meta property="og:image" content="https://cantclickthis.dev/social-card.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={`https://cantclickthis.dev/lab/${section.id}`} />
  </head>

  <body class="lab-page">
    <a class="skip" href={`#${section.id}`}>Skip to the example</a>

    <p class="vh" role="status" aria-live="polite" data-announce></p>

    <header class="lab-page__banner">
      <p class="hero__kicker">Screen reader lab {section.n} of {total}</p>
      <p>
        <a href="/lab/">All screen reader labs</a>
        <span aria-hidden="true"> · </span>
        <a href="/">Talk demo</a>
      </p>
    </header>

    <main class="lab-page__main" id="main" data-playground tabindex="-1">
      <h1>{section.title}</h1>
      <p>{section.tryIt}</p>

      <section id={section.id} aria-labelledby="example-title">
        <h2 class="lab-page__label" id="example-title">Example</h2>
        <div class="lab">
          <p class="lab__bar" aria-hidden="true">
            <span class="lab__dot"></span>
            <span>example.com</span>
          </p>
          <div class="lab__stage" data-stage set:html={failMarkup}></div>
        </div>
      </section>

      <section class="lab-editor" aria-labelledby="editor-title">
        <h2 class="lab-page__label" id="editor-title">Markup</h2>
        <p>
          Edit the HTML. The example above is live in this page, so Tab and a
          screen reader read it the same way they would on any other site.
        </p>
        <label for="lab-markup">HTML for the example</label>
        <div class="lab-editor__wrap">
          <pre class="lab-editor__highlight" aria-hidden="true"><code data-highlight set:html={failHighlighted}></code></pre>
          <textarea
            id="lab-markup"
            class="lab-editor__code"
            data-editor
            spellcheck="false"
            autocapitalize="off"
            autocomplete="off"
            wrap="off"
            rows="12"
          >{failMarkup}</textarea>
        </div>
        <div class="lab-editor__tools">
          <button type="button" class="btn" data-reset>Reset to the starting markup</button>
          <button type="button" class="btn" data-load-fix>Load one possible fix</button>
        </div>
      </section>

      <script type="application/json" data-lab-source set:html={source}></script>
    </main>

    <nav class="lab-page__pager" aria-label="Labs">
      {prev ? (
        <a href={`/lab/${prev.id}`}>Previous: {prev.title}</a>
      ) : (
        <span></span>
      )}
      {next ? (
        <a href={`/lab/${next.id}`}>Next: {next.title}</a>
      ) : (
        <a href="/lab/">Back to all labs</a>
      )}
    </nav>

    <BrandFooter />

    <script src="../../scripts/app.js"></script>
    <script src="../../scripts/lab.js"></script>
  </body>
</html>
