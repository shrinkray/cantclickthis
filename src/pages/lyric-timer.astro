---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Lyric timer — cantclickthis.dev</title>
    <meta name="robots" content="noindex" />
    <style is:inline>
      .tool { max-width: 60rem; margin: 0 auto; padding: 3rem 1.5rem 6rem; }
      .tool h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -0.03em; margin-block-end: 0.75rem; }
      .tool audio { width: 100%; margin-block: 1rem; }
      .tap {
        font: 700 1.35rem var(--display);
        inline-size: 100%;
        padding: 1.6rem;
        border-radius: 14px;
        border: 2px solid var(--fix);
        background: var(--ink-2);
        color: var(--paper);
        cursor: pointer;
      }
      .tap:hover { background: var(--ink-3); }
      .tap:disabled { opacity: 0.5; cursor: not-allowed; }
      .next { font-family: var(--mono); font-size: 1.1rem; color: var(--fix); min-height: 1.6em; margin-block: 1rem 0.5rem; }
      .tools { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-block: 1.25rem; align-items: center; }
      .sound {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        align-items: center;
        margin-block: 0.75rem 0;
      }
      .sound label { font-weight: 650; }
      .sound input {
        font: inherit;
        font-family: var(--mono);
        padding: 0.5rem 0.7rem;
        border-radius: 8px;
        border: 1px solid var(--line);
        background: var(--ink-2);
        color: var(--paper);
        min-inline-size: 16rem;
      }
      kbd {
        font-family: var(--mono);
        font-size: 0.85em;
        border: 1px solid var(--line);
        border-radius: 4px;
        padding: 0.05rem 0.35rem;
        background: var(--ink-3);
      }
      .cues-head,
      .cues li {
        display: grid;
        grid-template-columns: 5rem 5rem 8rem 1fr;
        gap: 0.75rem;
        padding: 0.35rem 0.5rem;
      }
      .cues-head {
        font-family: var(--mono);
        font-size: 0.72rem;
        color: var(--paper-dim);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-block-start: 1.5rem;
      }
      .cues { list-style: none; padding: 0; margin: 0; font-family: var(--mono); font-size: 0.85rem; display: grid; gap: 0.2rem; }
      .cues li {
        border-block-end: 1px solid var(--ink-3);
        color: #74869e;
        cursor: pointer;
        border-radius: 6px;
      }
      .cues li[data-done="true"] { color: var(--paper); }
      .cues li[aria-current="true"] {
        background: var(--ink-3);
        box-shadow: inset 0 0 0 1px var(--fix);
      }
      .cues b { color: var(--fix); font-weight: 600; }
      .cues .kind { color: var(--paper-dim); font-size: 0.75rem; }
    </style>
  </head>

  <body>
    <div class="tool">
      <p><a href="/">Back to the demo site</a></p>
      <h1>Lyric timer</h1>
      <p>
        Play the track and hit <strong>Mark line</strong> (or <kbd>M</kbd>) on the first
        beat of the selected line. Existing times load from the JSON, so you can retake
        one cue or drop in a scratch without redoing the whole song.
      </p>
      <p>
        Scratches, reverb, and other non-speech hits belong on their own cue: seek to
        the sound, type a label like <code>[record scratch]</code>, and insert it at
        the playhead. It inherits the surrounding stanza so it shows up in the player
        with that chorus or verse.
      </p>
      <p>
        When you are done, download <code>cantclickthis.json</code> into
        <code>public/lyrics/</code>, then run <code>pnpm run lyrics</code> to rebuild the
        caption track from it.
      </p>

      <audio controls preload="auto" data-timer-audio>
        <source src="/audio/cantclickthis.mp3" type="audio/mpeg" />
        <source src="/audio/cantclickthis.m4a" type="audio/mp4" />
      </audio>

      <p class="next" data-next aria-live="polite">Loading lines…</p>

      <button type="button" class="tap" data-tap disabled aria-keyshortcuts="m">Mark line</button>

      <div class="sound">
        <label for="sound-text">Sound cue</label>
        <input
          id="sound-text"
          data-sound-text
          list="sound-presets"
          value="[record scratch]"
          autocomplete="off"
        />
        <datalist id="sound-presets">
          <option value="[record scratch]"></option>
          <option value="[reverb]"></option>
          <option value="[vinyl scratch]"></option>
        </datalist>
        <button type="button" class="btn" data-insert>Insert at playhead</button>
      </div>

      <div class="tools">
        <button type="button" class="btn" data-undo>Undo</button>
        <button type="button" class="btn" data-remove>Remove selected</button>
        <button type="button" class="btn" data-reset>Start over</button>
        <button type="button" class="btn" data-download-json>Download JSON</button>
        <button type="button" class="btn" data-download-vtt>Download VTT</button>
      </div>

      <h2>Cues</h2>
      <div class="cues-head" aria-hidden="true">
        <span>Start</span>
        <span>End</span>
        <span>Part</span>
        <span>Text</span>
      </div>
      <ol class="cues" data-cues></ol>
    </div>

    <script>
      const audio = document.querySelector('[data-timer-audio]');
      const tap = document.querySelector('[data-tap]');
      const next = document.querySelector('[data-next]');
      const cueList = document.querySelector('[data-cues]');
      const soundText = document.querySelector('[data-sound-text]');

      let original = null;
      let lines = [];
      let marks = [];
      let selected = 0;
      let history = [];
      let dirty = false;

      const fmt = (n) => (n === undefined ? '—' : n.toFixed(2));

      const stamp = (seconds) => {
        const t = Math.max(0, Number(seconds) || 0);
        const hh = String(Math.floor(t / 3600)).padStart(2, '0');
        const mm = String(Math.floor((t % 3600) / 60)).padStart(2, '0');
        const ss = String(Math.floor(t % 60)).padStart(2, '0');
        const ms = String(Math.round((t % 1) * 1000)).padStart(3, '0');
        return `${hh}:${mm}:${ss}.${ms}`;
      };

      const snapshot = () => ({
        lines: lines.map((line) => ({ ...line })),
        marks: [...marks],
        selected
      });

      function restore(entry) {
        lines = entry.lines.map((line) => ({ ...line }));
        marks = [...entry.marks];
        selected = entry.selected;
      }

      function pushHistory() {
        history.push(snapshot());
      }

      function endOf(index) {
        if (marks[index + 1] !== undefined) return marks[index + 1];
        if (marks[index] !== undefined && index === lines.length - 1) return audio.duration;
        return undefined;
      }

      function paint() {
        cueList.replaceChildren(
          ...lines.map((line, i) => {
            const item = document.createElement('li');
            item.dataset.done = String(marks[i] !== undefined);
            item.tabIndex = 0;
            item.setAttribute('aria-current', selected === i ? 'true' : 'false');

            const start = document.createElement('b');
            start.textContent = fmt(marks[i]);
            const end = document.createElement('span');
            end.textContent = fmt(endOf(i));
            const part = document.createElement('span');
            part.className = 'kind';
            part.textContent = line.kind === 'sound' ? `${line.part} · sound` : line.part;
            const text = document.createElement('span');
            text.textContent = line.text;
            item.append(start, end, part, text);

            item.addEventListener('click', () => {
              selected = i;
              paint();
            });
            item.addEventListener('keydown', (event) => {
              if (event.key === 'Enter') {
                selected = i;
                paint();
              }
            });
            return item;
          })
        );

        tap.disabled = lines.length === 0;
        const current = lines[selected];
        next.textContent = current
          ? `Selected (${selected + 1} of ${lines.length}): ${current.text}`
          : 'No cues loaded.';
      }

      function hydrate(data) {
        original = data;
        lines = data.lines.map((line) => ({ ...line }));
        marks = lines.map((line) =>
          typeof line.start === 'number' ? Number(line.start.toFixed(2)) : undefined
        );
        selected = marks.findIndex((mark) => mark === undefined);
        if (selected === -1) selected = 0;
        history = [];
        dirty = false;
        paint();
      }

      function markSelected() {
        if (!lines[selected]) return;
        pushHistory();
        marks[selected] = Number(audio.currentTime.toFixed(2));
        dirty = true;
        if (selected < lines.length - 1) selected += 1;
        paint();
      }

      function insertSound() {
        const text = (soundText.value || '').trim() || '[record scratch]';
        const time = Number(audio.currentTime.toFixed(2));
        let index = marks.findIndex((mark) => mark !== undefined && mark > time);
        if (index === -1) index = lines.length;

        const neighbour = lines[index - 1] ?? lines[index];
        pushHistory();
        lines.splice(index, 0, {
          part: neighbour?.part || 'Intro',
          kind: 'sound',
          text
        });
        marks.splice(index, 0, time);
        selected = index;
        dirty = true;
        paint();
      }

      function build() {
        const duration = Number((audio.duration || original?.meta?.duration || 63.96).toFixed(2));
        const verified = dirty
          ? marks.every((mark) => mark !== undefined)
          : Boolean(original?.meta?.timingsVerified);

        return {
          meta: {
            title: original?.meta?.title || "Can't Click This",
            artist: original?.meta?.artist || 'toledogeeks',
            duration,
            timingsVerified: verified,
            ...(verified
              ? {}
              : { note: original?.meta?.note || 'Line times are estimates. Open /lyric-timer to correct them.' })
          },
          lines: lines.map((line, i) => ({
            start: Number((marks[i] ?? line.start ?? 0).toFixed(2)),
            end: Number((marks[i + 1] ?? duration).toFixed(2)),
            part: line.part,
            ...(line.kind ? { kind: line.kind } : {}),
            text: line.text
          }))
        };
      }

      function download(name, content, type) {
        const url = URL.createObjectURL(new Blob([content], { type }));
        const link = document.createElement('a');
        link.href = url;
        link.download = name;
        link.click();
        URL.revokeObjectURL(url);
      }

      tap.addEventListener('click', markSelected);

      document.querySelector('[data-insert]').addEventListener('click', insertSound);

      document.querySelector('[data-undo]').addEventListener('click', () => {
        const previous = history.pop();
        if (!previous) return;
        restore(previous);
        paint();
      });

      document.querySelector('[data-remove]').addEventListener('click', () => {
        if (!lines[selected]) return;
        pushHistory();
        lines.splice(selected, 1);
        marks.splice(selected, 1);
        if (selected >= lines.length) selected = Math.max(0, lines.length - 1);
        dirty = true;
        paint();
      });

      document.querySelector('[data-reset]').addEventListener('click', () => {
        if (!original) return;
        audio.currentTime = 0;
        hydrate(original);
      });

      document.querySelector('[data-download-json]').addEventListener('click', () => {
        download('cantclickthis.json', JSON.stringify(build(), null, 2), 'application/json');
      });

      document.querySelector('[data-download-vtt]').addEventListener('click', () => {
        const data = build();
        const cues = data.lines.map((line, i) => {
          const text = line.kind === 'sound' && !line.text.startsWith('[') ? `[${line.text}]` : line.text;
          return `${i + 1}\n${stamp(line.start)} --> ${stamp(line.end)}\n${text}\n`;
        });
        download('cantclickthis.vtt', ['WEBVTT', '', ...cues].join('\n'), 'text/vtt');
      });

      document.addEventListener('keydown', (event) => {
        if (event.metaKey || event.ctrlKey || event.altKey) return;
        const typing = event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement;
        if (typing) return;
        if (event.key === 'm' || event.key === 'M') {
          event.preventDefault();
          markSelected();
        }
      });

      audio.addEventListener('loadedmetadata', paint);

      fetch('/lyrics/cantclickthis.json')
        .then((r) => r.json())
        .then(hydrate)
        .catch(() => {
          next.textContent = 'Could not load /lyrics/cantclickthis.json.';
        });
    </script>
  </body>
</html>
